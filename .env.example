# Copy this file to .env and fill in real values. .env is gitignored.

# Choose one provider:
LLM_PROVIDER=gemini            # "anthropic" or "gemini"
LLM_MODEL=gemini-flash-lite-latest   # e.g. claude-sonnet-5 for anthropic

# Anthropic (console.anthropic.com -> Settings -> Billing -> API keys)
ANTHROPIC_API_KEY=

# Gemini (aistudio.google.com/apikey -- has a genuine free tier)
GEMINI_API_KEY=

# Mock app operator credentials (demo-only, not real secrets)
MOCK_APP_USERNAME=operator
MOCK_APP_PASSWORD=demo-pass
